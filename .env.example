# biasly environment variables — canonical list (see AGENTS.md section 21).
# Copy to .env.local and fill in real values. Only NEXT_PUBLIC_* values may
# reach browser code; everything else is server-only.

# --- Clerk (authentication) -------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# --- PostHog (product analytics) -------------------------------------------
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token_here
NEXT_PUBLIC_POSTHOG_HOST=https://your-posthog-host

# --- Supabase (persistence) -------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Oxylabs (scraping + scheduler) ----------------------------------------
OXY_WSA_USERNAME=
OXY_WSA_PASSWORD=

# --- OpenAI (analysis + embeddings) ----------------------------------------
OPENAI_API_KEY=

# --- Pipeline ---------------------------------------------------------------
# Shared secret for the x-biasly-admin-secret header on action routes.
BIASLY_ADMIN_SECRET=
# Optional; articles analyzed per batch (default 5).
ANALYSIS_BATCH_SIZE=

# CRON_SECRET protects GET /api/cron/pipeline. Vercel injects it automatically —
# do not add it to .env.local.
